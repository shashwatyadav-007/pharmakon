# PharmaKon Backend Environment Configuration
APP_NAME="PharmaKon"
APP_VERSION="0.1.0"
DEBUG=True
API_V1_PREFIX="/api/v1"
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
EXPIRY_ALERT_DAYS=60

# Database Configuration (PostgreSQL 15+ via Psycopg 3)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/pharmakon"
DB_ECHO=False

# AI Assistant Configuration
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
AI_MODEL_NAME="gemini-3.5-flash"
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT=30
